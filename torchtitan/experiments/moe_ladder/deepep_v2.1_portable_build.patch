@@ -0,0 +1,117 @@
+// Local patch: intranode-only build (DISABLE_NVSHMEM=1).
+// Stub definitions for every symbol normally provided by nvshmem.cu,
+// legacy/internode.cu, and legacy/internode_ll.cu so the legacy Buffer still
+// links. Calling any internode path aborts with a clear message.
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <optional>
+
+#include <cuda_runtime.h>
+
+#include "../legacy/api.cuh"
+
+namespace {
+
+[[noreturn]] void ep_internode_stub_abort(const char* name) {
+    std::fprintf(stderr,
+                 "DeepEP was built with DISABLE_NVSHMEM=1 (intranode only); "
+                 "%s is unavailable.\n",
+                 name);
+    std::abort();
+}
+
+}  // namespace
+
+namespace deep_ep::nvshmem {
+
+std::vector<uint8_t> get_unique_id() { ep_internode_stub_abort("nvshmem::get_unique_id"); }
+
+int init(const std::vector<uint8_t>&, const int&, const int&, const int&) {
+    ep_internode_stub_abort("nvshmem::init");
+}
+
+void* alloc(const size_t&, const size_t&) { ep_internode_stub_abort("nvshmem::alloc"); }
+
+void free(void*) { ep_internode_stub_abort("nvshmem::free"); }
+
+void barrier(const bool&, const std::optional<cudaStream_t>&) {
+    ep_internode_stub_abort("nvshmem::barrier");
+}
+
+void finalize() {
+    // Buffer teardown may call finalize unconditionally; make it a no-op.
+}
+
+}  // namespace deep_ep::nvshmem
+
+namespace deep_ep::legacy {
+
+namespace internode {
+
+int get_source_meta_bytes() { ep_internode_stub_abort("internode::get_source_meta_bytes"); }
+
+void notify_dispatch(const int*, int*, int, const int*, int*, const int*, int*, int,
+                     const bool*, int, int, int, int, int, int, int, int*, int*, int*,
+                     int*, void*, int, void**, int, int**, int, cudaStream_t, int64_t,
+                     int64_t, bool) {
+    ep_internode_stub_abort("internode::notify_dispatch");
+}
+
+void dispatch(void*, float*, topk_idx_t*, float*, void*, const void*, const float*,
+              const topk_idx_t*, const float*, int*, int*, int*, int*, const int*,
+              const int*, const int*, const int*, const bool*, int, int, int, int, int,
+              int, int, int, void*, int, int, void**, int, int, int, int, bool,
+              cudaStream_t, int, bool) {
+    ep_internode_stub_abort("internode::dispatch");
+}
+
+void cached_notify(int, int, int, int, int, int, int, int*, const int*, const int*,
+                   int*, void*, int, void**, int, int**, int, cudaStream_t, int64_t,
+                   int64_t, bool, bool) {
+    ep_internode_stub_abort("internode::cached_notify");
+}
+
+void combine(cudaDataType_t, void*, float*, const bool*, const void*, const float*,
+             const void*, const void*, const int*, const int*, const void*, const int*,
+             const int*, const int*, int, int, int, int, void*, int, int, void**, int,
+             int, int, int, cudaStream_t, int, bool) {
+    ep_internode_stub_abort("internode::combine");
+}
+
+}  // namespace internode
+
+namespace internode_ll {
+
+void clean_low_latency_buffer(int*, int, int*, int, int, int, int*, int*, cudaStream_t) {
+    ep_internode_stub_abort("internode_ll::clean_low_latency_buffer");
+}
+
+void dispatch(void*, void*, int*, int64_t*, int*, int*, int*, int64_t*, void*, int*,
+              void*, const void*, const topk_idx_t*, int*, int, int, int, int, int,
+              int, int, int, bool, bool, bool, void*, int, cudaStream_t, int) {
+    ep_internode_stub_abort("internode_ll::dispatch");
+}
+
+void combine(void*, void*, int*, void*, const void*, const topk_idx_t*, const float*,
+             const int*, const int64_t*, int*, int64_t*, int*, int, int, int, int, int,
+             int, int, int, bool, void*, int, cudaStream_t, int, bool) {
+    ep_internode_stub_abort("internode_ll::combine");
+}
+
+void query_mask_buffer(int*, int, int*, cudaStream_t) {
+    ep_internode_stub_abort("internode_ll::query_mask_buffer");
+}
+
+void update_mask_buffer(int*, int, bool, cudaStream_t) {
+    ep_internode_stub_abort("internode_ll::update_mask_buffer");
+}
+
+void clean_mask_buffer(int*, int, cudaStream_t) {
+    ep_internode_stub_abort("internode_ll::clean_mask_buffer");
+}
+
+}  // namespace internode_ll
+
+}  // namespace deep_ep::legacy
